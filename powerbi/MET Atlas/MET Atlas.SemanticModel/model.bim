        "measures": [
          {
            "name": "Gallery Artwork Count",
            "expression": [
              "COUNTROWS(Gallery)"
            ],
            "displayFolder": "Müze sunumu",
            "formatString": "#,0"
          },
          {
            "name": "Gallery Image Count",
            "expression": [
              "CALCULATE(COUNTROWS(Gallery), Gallery[image_url] <> \"\")"
            ],
            "displayFolder": "Müze sunumu",
            "formatString": "#,0"
          },
          {
            "name": "Gallery Tab Label",
            "expression": [
              "FORMAT(COALESCE(COUNTROWS(Gallery), 0), \"#,0\") & \" eser\""
            ],
            "displayFolder": "Müze sunumu",
            "isHidden": true
          },
          {
            "name": "Gallery Default ID",
            "expression": [
              "VAR best = MINX(TOPN(1, FILTER(Gallery, Gallery[image_url] <> \"\"), Gallery[era_rank], ASC, Gallery[wikipedia_languages], DESC, Gallery[object_id], ASC), Gallery[object_id])",
              "RETURN COALESCE(best, MIN(Gallery[object_id]))"
            ],
            "displayFolder": "Müze sunumu",
            "isHidden": true
          },
          {
            "name": "Selected Gallery ID",
            "expression": [
              "VAR one = IF(HASONEVALUE(Gallery[object_id]), VALUES(Gallery[object_id]))",
              "VAR picked = COALESCE(one, [Gallery Default ID])",
              "VAR withoutPick = CALCULATE([Gallery Default ID], REMOVEFILTERS(Gallery[era_rank], Gallery[thumb_url], Gallery[title], Gallery[begin_year]))",
              "VAR roomDefault = CALCULATE([Gallery Default ID], REMOVEFILTERS(Gallery))",
              "RETURN COALESCE(picked, withoutPick, roomDefault)"
            ],
            "displayFolder": "Müze sunumu",
            "isHidden": true
          },
          {
            "name": "Selected Gallery Image",
            "expression": [
              "VAR selId = [Selected Gallery ID]",
              "VAR link = MAXX(FILTER(ALL(Gallery), Gallery[object_id] = selId), Gallery[image_url])",
              "RETURN IF(ISBLANK(selId), BLANK(), IF(link = \"\", \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='480' height='600' viewBox='0 0 480 600'><defs><radialGradient id='g' cx='50%25' cy='38%25' r='75%25'><stop offset='0' stop-color='%23F4EDE0'/><stop offset='1' stop-color='%23D9CDB8'/></radialGradient></defs><rect width='480' height='600' fill='url(%23g)'/><rect x='170' y='170' width='140' height='110' fill='none' stroke='%23A7967B' stroke-width='3'/><path d='M182 266 L222 222 L248 248 L268 230 L298 266 Z' fill='%23BFAF93'/><circle cx='280' cy='198' r='11' fill='%23BFAF93'/><text x='240' y='336' text-anchor='middle' font-family='Georgia' font-size='25' fill='%234A3F35'>G%C3%B6rsel a%C3%A7%C4%B1k eri%C5%9Fimde de%C4%9Fil</text><text x='240' y='372' text-anchor='middle' font-family='Segoe UI' font-size='14.5' fill='%236E6052'>The Met bu eser i%C3%A7in a%C3%A7%C4%B1k eri%C5%9Fim g%C3%B6rseli yay%C4%B1mlam%C4%B1yor.</text><text x='240' y='394' text-anchor='middle' font-family='Segoe UI' font-size='14.5' fill='%236E6052'>Eseri sa%C4%9Fdaki %E2%80%9CThe Met eser sayfas%C4%B1%E2%80%9D ba%C4%9Flant%C4%B1s%C4%B1nda g%C3%B6r%C3%BCn.</text></svg>\", link))"
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Selected Met URL",
            "expression": [
              "VAR selId = [Selected Gallery ID]",
              "VAR link = MAXX(FILTER(ALL(Gallery), Gallery[object_id] = selId), Gallery[met_url])",
              "RETURN IF(link = \"\", BLANK(), link)"
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "WebUrl"
          },
          {
            "name": "Selected Artist Wiki URL",
            "expression": [
              "VAR selId = [Selected Gallery ID]",
              "VAR link = MAXX(FILTER(ALL(Gallery), Gallery[object_id] = selId), Gallery[artist_wiki_url])",
              "RETURN IF(link = \"\", BLANK(), link)"
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "WebUrl"
          },
          {
            "name": "Selected Object Wiki URL",
            "expression": [
              "VAR selId = [Selected Gallery ID]",
              "VAR link = MAXX(FILTER(ALL(Gallery), Gallery[object_id] = selId), Gallery[object_wiki_url])",
              "RETURN IF(link = \"\", BLANK(), link)"
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "WebUrl"
          },
