        "partitions": [
          {
            "name": "Gallery",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Source, {\"object_id\", \"title\", \"artist\", \"artist_bio\", \"culture\", \"date\", \"begin_year\", \"era\", \"era_order\", \"department\", \"kind\", \"medium\", \"size_cm\", \"credit_line\", \"accession_number\", \"gallery_number\", \"kind_label\", \"era_rank\", \"wikipedia_languages\", \"artist_wikipedia_languages\", \"image_url\", \"thumb_url\", \"met_url\", \"artist_wiki_url\", \"object_wiki_url\", \"sight_x\", \"sight_y\", \"sight_w\", \"sight_h\"}),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"object_id\", Int64.Type}, {\"title\", type text}, {\"artist\", type text}, {\"artist_bio\", type text}, {\"culture\", type text}, {\"date\", type text}, {\"begin_year\", Int64.Type}, {\"era\", type text}, {\"era_order\", Int64.Type}, {\"department\", type text}, {\"kind\", type text}, {\"medium\", type text}, {\"size_cm\", type text}, {\"credit_line\", type text}, {\"accession_number\", type text}, {\"gallery_number\", type text}, {\"kind_label\", type text}, {\"era_rank\", Int64.Type}, {\"wikipedia_languages\", Int64.Type}, {\"artist_wikipedia_languages\", Int64.Type}, {\"image_url\", type text}, {\"thumb_url\", type text}, {\"met_url\", type text}, {\"artist_wiki_url\", type text}, {\"object_wiki_url\", type text}, {\"sight_x\", type number}, {\"sight_y\", type number}, {\"sight_w\", type number}, {\"sight_h\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "description": "The 50 best-known highlight artworks with an open-access image in each era (465 rows), ranked by the number of Wikipedia languages about the artwork, then its artist (Wikidata). Met Collection API images and wall-label details. Independent of full-collection totals; see highlights-catalog.json for the snapshot date."
      },
      {
        "name": "Gallery Era",
        "columns": [
          {
            "name": "era",
            "dataType": "string",
            "sourceColumn": "era",
            "summarizeBy": "none",
            "sortByColumn": "era_order"
          },
          {
            "name": "era_order",
            "dataType": "int64",
            "sourceColumn": "era_order",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "description": "Era tabs of the Masterpieces room.",
        "partitions": [
          {
            "name": "Gallery Era",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = #table({\"era\", \"era_order\"}, {{\"MÖ 8000–2000\", 2}, {\"MÖ 2000–1000\", 3}, {\"MÖ 1000–MS 1\", 4}, {\"MS 1–500\", 5}, {\"500–1000\", 6}, {\"1000–1400\", 7}, {\"1400–1600\", 8}, {\"1600–1800\", 9}, {\"1800–1900\", 10}, {\"1900–günümüz\", 11}}),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"era\", type text}, {\"era_order\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Gallery Department",
        "columns": [
          {
            "name": "department",
            "dataType": "string",
            "sourceColumn": "department",
            "summarizeBy": "none"
          }
        ],
        "description": "Department picker of the Masterpieces room.",
        "partitions": [
          {
            "name": "Gallery Department",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = #table({\"department\"}, {{\"Ancient Near Eastern Art\"}, {\"Arms and Armor\"}, {\"Arts of Africa, Oceania, and the Americas\"}, {\"Asian Art\"}, {\"Costume Institute\"}, {\"Drawings and Prints\"}, {\"Egyptian Art\"}, {\"European Paintings\"}, {\"European Sculpture and Decorative Arts\"}, {\"Greek and Roman Art\"}, {\"Islamic Art\"}, {\"Medieval Art\"}, {\"Modern and Contemporary Art\"}, {\"Musical Instruments\"}, {\"Photographs\"}, {\"Robert Lehman Collection\"}, {\"The American Wing\"}, {\"The Cloisters\"}, {\"The Libraries\"}}),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"department\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Gallery Type",
        "columns": [
          {
            "name": "kind_label",
            "dataType": "string",
            "sourceColumn": "kind_label",
            "summarizeBy": "none"
          }
        ],
        "description": "Painting/object picker of the Masterpieces room.",
        "partitions": [
          {
            "name": "Gallery Type",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = #table({\"kind_label\"}, {{\"Obje\"}, {\"Resim\"}}),",
                "    Typed = Table.TransformColumnTypes(Rows, {{\"kind_label\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ],
