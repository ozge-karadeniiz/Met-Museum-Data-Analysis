          {
            "name": "Gallery Wall Label SVG",
            "expression": [
              "VAR selId = [Selected Gallery ID]",
              "VAR r = FILTER(ALL(Gallery), Gallery[object_id] = selId)",
              "VAR title = MAXX(r, Gallery[title])",
              "VAR dateValue = MAXX(r, Gallery[date])",
              "VAR dateText = IF(dateValue = \"\", \"\", \", \" & dateValue)",
              "VAR artist = MAXX(r, Gallery[artist])",
              "VAR bio = MAXX(r, Gallery[artist_bio])",
              "VAR galleryNo = MAXX(r, Gallery[gallery_number])",
              "VAR flags = IF(galleryNo = \"\", \"GALERİ BİLGİSİ YOK\", \"GALERİ \" & galleryNo) & \" · \" & UPPER(MAXX(r, Gallery[era]))",
              "    & IF(MAXX(r, Gallery[image_url]) = \"\", \" · GÖRSEL PAYLAŞILAMIYOR\", \"\")",
              "VAR langs = MAXX(r, Gallery[wikipedia_languages])",
              "VAR fame = \"DÖNEMİNDE \" & MAXX(r, Gallery[era_rank]) & \". SIRA · \"",
              "    & IF(langs > 0, langs & \" DİLDE WIKIPEDIA MADDESİ\", \"WIKIPEDIA MADDESİ YOK\")",
              "VAR sizeText = MAXX(r, Gallery[size_cm])",
              "VAR medium = MAXX(r, Gallery[medium]) & IF(sizeText = \"\", \"\", \" · \" & sizeText)",
              "VAR cultureText = MAXX(r, Gallery[culture])",
              "VAR dept = MAXX(r, Gallery[department]) & IF(cultureText = \"\", \"\", \" · \" & cultureText)",
              "VAR credit = MAXX(r, Gallery[credit_line])",
              "VAR acc = MAXX(r, Gallery[accession_number])",
              "VAR ts = IF(LEN(title) < 40, \"20\", IF(LEN(title) < 75, \"17\", \"14.5\"))",
              "RETURN IF(ISBLANK(selId), BLANK(),",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='348' height='392' viewBox='0 0 348 392'><defs><filter id='s' x='-20%25' y='-20%25' width='140%25' height='140%25'><feGaussianBlur stdDeviation='6'/></filter><linearGradient id='p' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='%23FBF7EE'/><stop offset='1' stop-color='%23EFE7D7'/></linearGradient></defs><rect x='10' y='12' width='328' height='372' fill='%23000' fill-opacity='0.55' filter='url(%23s)'/><rect x='6' y='4' width='336' height='376' fill='url(%23p)'/><foreignObject x='6' y='4' width='336' height='376'><div xmlns='http://www.w3.org/1999/xhtml'><div style='font-family:Segoe UI;color:%232A211B;padding:20px 22px'><div style='font-size:9.5px;letter-spacing:2.2px;color:%238E2A2F;font-weight:600'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(flags, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='font-size:8.5px;letter-spacing:1.6px;color:%236E6052;margin-top:4px'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(fame, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='font-family:Georgia;font-size:19px;line-height:1.2;margin-top:9px;max-height:46px;overflow:hidden;text-overflow:ellipsis'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(artist, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='font-family:Georgia;font-style:italic;font-size:11.5px;color:%236E6052;margin-top:3px;max-height:30px;overflow:hidden;text-overflow:ellipsis'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(bio, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='height:1px;background:%23C9A45C;margin:13px 0 12px'></div><div style='font-family:Georgia;font-style:italic;line-height:1.25;max-height:98px;overflow:hidden;text-overflow:ellipsis;font-size:\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(ts, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"px'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(title, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"<span style='font-style:normal'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(dateText, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</span></div><div style='font-size:11.5px;margin-top:10px;max-height:58px;overflow:hidden;text-overflow:ellipsis'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(medium, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='font-size:11.5px;color:%236E6052;margin-top:2px;max-height:30px;overflow:hidden;text-overflow:ellipsis'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(dept, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div><div style='font-size:10px;color:%236E6052;margin-top:12px;line-height:1.45;max-height:60px;overflow:hidden;text-overflow:ellipsis'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(credit, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"<br/>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(acc, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div></div></div></foreignObject></svg>\")"
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Narrative Gallery",
            "expression": [
              "VAR scopeName = IF(HASONEVALUE('Gallery Era'[era]), VALUES('Gallery Era'[era]), \"Tüm dönemler\")",
              "VAR n = COALESCE(COUNTROWS(Gallery), 0)",
              "RETURN",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='760' height='58' viewBox='0 0 760 58'><foreignObject x='0' y='0' width='760' height='58'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI;font-size:14px;line-height:1.55;color:%23CFC2AE;margin:0'>\"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(scopeName, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \"  %C2%B7  en bilinen \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(n, \"#,0\"), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" ba%C5%9Fyap%C4%B1t, Wikipedia dil say%C4%B1s%C4%B1na g%C3%B6re. Bir esere t%C4%B1kla.\"",
              "    & \"</div></foreignObject></svg>\""
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Lobby Artwork Image",
            "expression": [
              "\"https://images.metmuseum.org/CRDImages/ep/web-large/DP-42549-001.jpg\""
            ],
