        "lineageTag": "b159914c-2a26-4221-92aa-51faafb72f07",
        "measures": [
          {
            "name": "Artwork Count",
            "displayFolder": "Koleksiyon",
            "expression": "DISTINCTCOUNT(Artwork[object_id])",
            "formatString": "#,0",
            "lineageTag": "dfa6ab85-f809-44e7-9620-103e1644fecd"
          },
          {
            "name": "Department Count",
            "displayFolder": "Koleksiyon",
            "expression": "DISTINCTCOUNT(Artwork[department])",
            "formatString": "#,0",
            "lineageTag": "dccd2ebc-8a9b-4ec4-811d-c53def6c151c"
          },
          {
            "name": "Highlight Artwork Count",
            "displayFolder": "Koleksiyon",
            "expression": "CALCULATE([Artwork Count], KEEPFILTERS(Artwork[is_highlight] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "0fc924e0-7600-42ef-9888-1d7620ea7ea0"
          },
          {
            "name": "Highlight Share",
            "displayFolder": "Koleksiyon",
            "expression": "DIVIDE([Highlight Artwork Count], [Artwork Count])",
            "formatString": "0.0%",
            "lineageTag": "eda94c73-ffc3-48a7-ad54-71286a91ccec"
          },
          {
            "name": "Public Domain Artwork Count",
            "displayFolder": "Koleksiyon",
            "expression": "CALCULATE([Artwork Count], KEEPFILTERS(Artwork[is_public_domain] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "23114636-f428-4568-9912-728516216419"
          },
          {
            "name": "Public Domain Share",
            "displayFolder": "Koleksiyon",
            "expression": "DIVIDE([Public Domain Artwork Count], [Artwork Count])",
            "formatString": "0.0%",
            "lineageTag": "a68dd206-63cd-4f84-9c68-d77d6d979afa"
          },
          {
            "name": "Artwork With Gallery Information",
            "displayFolder": "Galeri bilgisi",
            "expression": "CALCULATE([Artwork Count], KEEPFILTERS(Artwork[is_on_view] = TRUE()))",
            "formatString": "#,0",
            "lineageTag": "d1980192-394c-4ad7-84ba-de66fa167c86"
          },
          {
            "name": "Gallery Information Share",
            "displayFolder": "Galeri bilgisi",
            "expression": "DIVIDE([Artwork With Gallery Information], [Artwork Count])",
            "formatString": "0.0%",
            "lineageTag": "3d308e7d-d9f2-4f8b-9f55-6b07ff6c48b4"
          },
          {
            "name": "Department Share",
            "displayFolder": "Koleksiyon",
            "expression": "DIVIDE([Artwork Count], CALCULATE([Artwork Count], REMOVEFILTERS(Artwork[department])))",
            "formatString": "0.0%",
            "lineageTag": "580181cc-75ab-49b9-bd4c-a0e04239423f"
          },
          {
            "name": "Reversed Date Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, NOT ISBLANK(Artwork[object_begin_date]) && NOT ISBLANK(Artwork[object_end_date]) && Artwork[object_begin_date] > Artwork[object_end_date]))",
            "formatString": "#,0",
            "lineageTag": "f12e6c89-f66b-4d23-9514-9b48375dfc28"
          },
          {
            "name": "Zero Year Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, (NOT ISBLANK(Artwork[object_begin_date]) && Artwork[object_begin_date] == 0) || (NOT ISBLANK(Artwork[object_end_date]) && Artwork[object_end_date] == 0)))",
            "formatString": "#,0",
            "lineageTag": "a5b35b26-a5a2-4d18-b41b-894b65ce525b"
          },
          {
            "name": "Missing Accession Year Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, ISBLANK(Artwork[accession_year])))",
            "formatString": "#,0",
            "lineageTag": "c3d7bdbd-41e0-45ef-ac6c-7521352dee9f"
          },
          {
            "name": "Missing Culture Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, ISBLANK(Artwork[culture]) || TRIM(Artwork[culture]) IN {\"\", \"Unknown\"}))",
            "formatString": "#,0",
            "lineageTag": "ff4e2bef-f989-47d0-a0c4-f42fdf36dea0"
          },
          {
            "name": "Missing Country Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, ISBLANK(Artwork[country]) || TRIM(Artwork[country]) IN {\"\", \"Unknown\"}))",
            "formatString": "#,0",
            "lineageTag": "7662c8a4-985a-4503-81af-4eca666f6b94"
          },
          {
            "name": "Missing Medium Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, ISBLANK(Artwork[medium]) || TRIM(Artwork[medium]) IN {\"\", \"Unknown\"}))",
            "formatString": "#,0",
            "lineageTag": "fd76a4fa-4067-4121-a87d-31e746036065"
          },
          {
            "name": "Missing Artist Attribution Count",
            "displayFolder": "Veri kalitesi",
            "expression": "CALCULATE([Artwork Count], FILTER(Artwork, ISBLANK(Artwork[artist_display_name]) || TRIM(Artwork[artist_display_name]) IN {\"\", \"Unknown\", \"Anonymous / Unknown\"}))",
            "formatString": "#,0",
            "lineageTag": "0988ced3-502f-49c1-8ceb-a894dcec5f57"
          },
          {
            "name": "Missing Field Count",
            "displayFolder": "Veri kalitesi",
            "expression": "SWITCH(SELECTEDVALUE(QualityField[Field]), \"Kültür\", [Missing Culture Count], \"Ülke\", [Missing Country Count], \"Malzeme\", [Missing Medium Count], \"Sanatçı atfı\", [Missing Artist Attribution Count], \"Edinim yılı\", [Missing Accession Year Count], BLANK())",
            "formatString": "#,0",
            "lineageTag": "02208d8a-906c-4925-8fa6-da841aabb503"
          },
          {
            "name": "Missing Field Share",
            "displayFolder": "Veri kalitesi",
            "expression": "DIVIDE([Missing Field Count], [Artwork Count])",
            "formatString": "0.0%",
            "lineageTag": "73d663e6-9d4f-4fd8-9820-abbc96f90afb"
          },
          {
            "name": "Narrative Overview",
            "expression": [
              "VAR n = [Artwork Count]",
              "VAR pd = [Public Domain Share]",
              "VAR topD = TOPN(1, VALUES(Artwork[department]), [Artwork Count], DESC, Artwork[department], ASC)",
              "VAR topName = COALESCE(MAXX(topD, Artwork[department]), \"—\")",
              "VAR topShare = CALCULATE([Department Share], topD)",
              "RETURN",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='760' height='58' viewBox='0 0 760 58'><foreignObject x='0' y='0' width='760' height='58'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI;font-size:14px;line-height:1.55;color:%23CFC2AE;margin:0'>\"",
              "    & \"Bu rotada \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(n, \"#,0\"), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" eser var; kamu mal%C4%B1 pay%C4%B1 \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(pd), \"hesaplanamıyor\", FORMAT(pd, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \". En kalabal%C4%B1k kanat \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(topName, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" %E2%80%94 t%C3%BCm departmanlar i%C3%A7indeki pay%C4%B1 \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(topShare), \"hesaplanamıyor\", FORMAT(topShare, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \".\"",
              "    & \"</div></foreignObject></svg>\""
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Narrative Departments",
            "expression": [
              "VAR t = FILTER(ADDCOLUMNS(VALUES(Artwork[department]), \"@g\", [Gallery Information Share]), NOT ISBLANK([@g]))",
              "VAR hi = TOPN(1, t, [@g], DESC, Artwork[department], ASC)",
              "VAR lo = TOPN(1, t, [@g], ASC, Artwork[department], ASC)",
              "VAR hiName = COALESCE(MAXX(hi, Artwork[department]), \"—\")",
              "VAR loName = COALESCE(MAXX(lo, Artwork[department]), \"—\")",
              "VAR hiShare = MAXX(hi, [@g])",
              "VAR loShare = MAXX(lo, [@g])",
              "RETURN",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='760' height='58' viewBox='0 0 760 58'><foreignObject x='0' y='0' width='760' height='58'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI;font-size:14px;line-height:1.55;color:%23CFC2AE;margin:0'>\"",
              "    & \"Galeri numaras%C4%B1 en s%C4%B1k kay%C4%B1tl%C4%B1 kanat \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(hiName, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" (\"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(hiShare), \"hesaplanamıyor\", FORMAT(hiShare, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \"), en seyrek \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(loName, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" (\"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(loShare), \"hesaplanamıyor\", FORMAT(loShare, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \"). Galeri numaras%C4%B1, eserin %C5%9Fu an sergilendi%C4%9Fini kan%C4%B1tlamaz.\"",
              "    & \"</div></foreignObject></svg>\""
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Narrative Periods",
            "expression": [
              "VAR topP = TOPN(1, VALUES(Artwork[timeline_period]), [Artwork Count], DESC, Artwork[timeline_period], ASC)",
              "VAR topName = COALESCE(MAXX(topP, Artwork[timeline_period]), \"—\")",
              "VAR busiestCount = CALCULATE([Artwork Count], topP)",
              "VAR oldPD = CALCULATE([Public Domain Share], KEEPFILTERS(Artwork[object_begin_date] < 1900))",
              "VAR newPD = CALCULATE([Public Domain Share], KEEPFILTERS(Artwork[object_begin_date] >= 1900))",
              "RETURN",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='760' height='58' viewBox='0 0 760 58'><foreignObject x='0' y='0' width='760' height='58'><div xmlns='http://www.w3.org/1999/xhtml' style='font-family:Segoe UI;font-size:14px;line-height:1.55;color:%23CFC2AE;margin:0'>\"",
              "    & \"En kalabal%C4%B1k d%C3%B6nem \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(topName, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" (\"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(busiestCount, \"#,0\"), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \" eser). Ba%C5%9Flang%C4%B1%C3%A7 y%C4%B1l%C4%B1 1900 %C3%B6ncesi eserlerde kamu mal%C4%B1 pay%C4%B1 \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(oldPD), \"hesaplanamıyor\", FORMAT(oldPD, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \", 1900 ve sonras%C4%B1nda \"",
              "    & \"<b style='color:%23E2C47E;font-family:Georgia;font-weight:normal;font-size:1.12em'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(newPD), \"hesaplanamıyor\", FORMAT(newPD, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</b>\"",
              "    & \".\"",
              "    & \"</div></foreignObject></svg>\""
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Top Culture",
            "expression": [
              "VAR t = FILTER(VALUES(Artwork[culture]), NOT ISBLANK(Artwork[culture]) && NOT (TRIM(Artwork[culture]) IN {\"\", \"Unknown\"}))",
              "RETURN MAXX(TOPN(1, t, [Artwork Count], DESC, Artwork[culture], ASC), Artwork[culture])"
            ],
            "displayFolder": "Müze sunumu"
          },
          {
            "name": "Tooltip Label SVG",
            "expression": [
              "VAR d = IF(HASONEVALUE(Artwork[department]), VALUES(Artwork[department]), \"Seçili departmanlar\")",
              "VAR n = [Artwork Count]",
              "VAR pd = [Public Domain Share]",
              "VAR gi = [Gallery Information Share]",
              "VAR hl = COALESCE([Highlight Artwork Count], 0)",
              "VAR cult = COALESCE([Top Culture], \"kayıtlı değil\")",
              "RETURN",
              "    \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='360' height='230' viewBox='0 0 360 230'><foreignObject x='0' y='0' width='360' height='230'><div xmlns='http://www.w3.org/1999/xhtml' style='margin:0;background:%23FBF7EE;height:226px;border:2px solid %23C9A45C;box-sizing:border-box'>\"",
              "    & \"<div style='padding:16px 20px;font-family:Segoe UI;color:%232A211B'>\"",
              "    & \"<div style='font-size:9px;letter-spacing:2.2px;color:%238E2A2F;font-weight:600'>DEPARTMAN %C2%B7 M%C3%9CZE ET%C4%B0KET%C4%B0</div>\"",
              "    & \"<div style='font-family:Georgia;font-size:19px;line-height:1.2;margin-top:6px;height:46px;overflow:hidden'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(d, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</div>\"",
              "    & \"<div style='height:1px;background:%23C9A45C;margin:8px 0 10px'></div>\"",
              "    & \"<table style='width:100%25;border-collapse:collapse;font-size:10px;color:%236E6052'><tr>\"",
              "    & \"<td style='width:50%25;padding:0 0 9px'>Eser<br/><span style='font-family:Georgia;font-size:19px;color:%232A211B'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(n, \"#,0\"), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</span></td>\"",
              "    & \"<td style='width:50%25;padding:0 0 9px'>Kamu mal%C4%B1 pay%C4%B1<br/><span style='font-family:Georgia;font-size:19px;color:%232A211B'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(pd), \"hesaplanamıyor\", FORMAT(pd, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</span></td></tr><tr>\"",
              "    & \"<td style='width:50%25;padding:0 0 9px'>Galeri bilgisi pay%C4%B1<br/><span style='font-family:Georgia;font-size:19px;color:%232A211B'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(gi), \"hesaplanamıyor\", FORMAT(gi, \"0.0%\")), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</span></td>\"",
              "    & \"<td style='width:50%25;padding:0 0 9px'>%C3%96ne %C3%A7%C4%B1kan eser<br/><span style='font-family:Georgia;font-size:19px;color:%232A211B'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(hl, \"#,0\"), \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</span></td>\"",
              "    & \"</tr></table><div style='font-size:10px;color:%236E6052'>En yayg%C4%B1n k%C3%BClt%C3%BCr: <i style='color:%232A211B;font-family:Georgia'>\"",
              "    & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(cult, \"&\", \"&amp;\"), \"<\", \"&lt;\"), \">\", \"&gt;\"), \"%\", \"%25\"), \"#\", \"%23\")",
              "    & \"</i></div></div>\"",
              "    & \"</div></foreignObject></svg>\""
            ],
            "displayFolder": "Müze sunumu",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Period Material Share",
            "expression": [
              "DIVIDE([Artwork Count], CALCULATE([Artwork Count], REMOVEFILTERS(Artwork[object_type_material])))"
            ],
            "displayFolder": "Müze sunumu",
            "formatString": "0.0%"
          },
          {
            "name": "Heat Fill",
            "expression": [
              "VAR s = [Period Material Share]",
              "RETURN SWITCH(TRUE(), ISBLANK(s), \"#F7F2E8\", s < 0.01, \"#F2EADB\", s < 0.025, \"#EADBC0\", s < 0.05, \"#E0C796\",",
              "    s < 0.10, \"#D3AC68\", s < 0.15, \"#C08A48\", s < 0.25, \"#A2603A\", s < 0.35, \"#83402F\", \"#5A1B1F\")"
            ],
            "displayFolder": "Müze sunumu",
            "isHidden": true
          },
          {
            "name": "Heat Ink",
            "expression": [
              "IF([Period Material Share] >= 0.15, \"#FBF6EC\", \"#2A211B\")"
            ],
            "displayFolder": "Müze sunumu",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Artwork",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = GoogleBigQuery.Database([BillingProject=\"the-met-open-access\", UseStorageApi=false]),",
                "    Project = Source{[Name=\"the-met-open-access\"]}[Data],",
                "    Dataset = Project{[Name=\"met_data\", Kind=\"Schema\"]}[Data],",
                "    Mart = Dataset{[Name=\"mart_met_objects\", Kind=\"Table\"]}[Data],",
                "    Typed = Table.TransformColumnTypes(Mart, {{\"object_id\", Int64.Type}, {\"object_number\", type text}, {\"title\", type text}, {\"object_name\", type text}, {\"department\", type text}, {\"is_highlight\", type logical}, {\"is_timeline_work\", type logical}, {\"is_public_domain\", type logical}, {\"is_on_view\", type logical}, {\"gallery_number\", type text}, {\"accession_year\", Int64.Type}, {\"accession_decade\", type text}, {\"object_date\", type text}, {\"object_begin_date\", Int64.Type}, {\"object_end_date\", Int64.Type}, {\"timeline_period\", type text}, {\"timeline_period_order\", Int64.Type}, {\"period\", type text}, {\"culture\", type text}, {\"country\", type text}, {\"credit_line\", type text}, {\"acquisition_category_broad\", type text}, {\"acquisition_type\", type text}, {\"primary_donor\", type text}, {\"artist_display_name\", type text}, {\"artist_nationality\", type text}, {\"artist_gender_standardized\", type text}, {\"artist_wikidata_url\", type text}, {\"object_type_material\", type text}, {\"classification\", type text}, {\"medium\", type text}, {\"dimensions\", type text}, {\"rights_and_reproduction\", type text}, {\"link_resource\", type text}})",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      },
